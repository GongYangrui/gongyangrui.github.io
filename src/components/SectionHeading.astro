---
interface Props {
  title: string;
  id?: string;
  actionLabel?: string;
  actionHref?: string;
}
const { title, id, actionLabel, actionHref } = Astro.props;
---

<header class="section-heading">
  <h2 {id}>{title}</h2>
  {actionLabel && actionHref && <a class="link link-hover section-action" href={actionHref}>{actionLabel} →</a>}
</header>
