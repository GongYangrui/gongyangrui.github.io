---
interface Props {
  title: string;
  id?: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, id, actionLabel, actionHref } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {actionLabel && actionHref && (
    <a class="section-action" href={actionHref}>{actionLabel} →</a>
  )}
</div>
