---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import PostRow from "./PostRow.astro";

interface Props {
  posts: CollectionEntry<"writing">[];
  lang: Locale;
  showDescriptions?: boolean;
}

const { posts, lang, showDescriptions = true } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => <PostRow {post} {lang} showDescription={showDescriptions} />)}
</div>
