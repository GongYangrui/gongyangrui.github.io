---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { formatDate, writingPath } from "../lib/content";

interface Props {
  posts: CollectionEntry<"writing">[];
  lang: Locale;
  showDescriptions?: boolean;
}

const { posts, lang, showDescriptions = true } = Astro.props;
---

<ol class="writing-list">
  {posts.map((post) => (
    <li class="writing-row">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, lang)}</time>
      <div class="writing-copy">
        <div class="writing-title-line">
          <h3><a class="writing-link" href={writingPath(post.data.lang, post.data.slug)}>{post.data.title}</a></h3>
          {post.data.lang !== lang && <span class="badge badge-ghost badge-sm">{post.data.lang.toUpperCase()}</span>}
        </div>
        {showDescriptions && <p>{post.data.description}</p>}
        <div class="tag-list compact" aria-label="Tags">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
      <span class="row-arrow" aria-hidden="true">↗</span>
    </li>
  ))}
</ol>
