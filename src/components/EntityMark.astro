---
interface Visual {
  src: string;
  alt: { en: string; zh: string };
}

interface Props {
  label: string;
  logo?: Visual;
}

const { label, logo } = Astro.props;
const stopWords = new Set(["of", "the", "with", "and", "for", "at", "in", "to", "a", "an"]);
const initials = label
  .trim()
  .split(/\s+/)
  .filter((word) => !stopWords.has(word.toLowerCase()))
  .slice(0, 2)
  .map((word) => word.charAt(0))
  .join("")
  .toUpperCase();
---

<span class="entity-mark" aria-hidden="true">
  {logo ? (
    <img src={logo.src} alt="" loading="lazy" decoding="async" />
  ) : (
    <span>{initials}</span>
  )}
</span>
