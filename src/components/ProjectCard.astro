---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { localized } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { data } = project;
const primaryLink = data.links[0]?.url;
const image = data.image;
const imageAlt = image?.alt?.[lang]?.trim() || data.name;
---

<article class:list={["project-entry", image && "project-entry--with-image"]}>
  <div class="project-details">
    <h3>{data.name}</h3>
    <p>{localized(data.summary, lang)}</p>
    {data.technologies.length > 0 && (
      <ul class="project-tags" aria-label={lang === "zh" ? "技术栈" : "Tech stack"}>
        {data.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    )}
    {data.links.length > 0 && (
      <p class="project-links">
        {data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer">{localized(link.label, lang)} ↗</a>
        ))}
      </p>
    )}
  </div>
  {image && (
    primaryLink ? (
      <a class="project-preview" href={primaryLink} target="_blank" rel="noreferrer" tabindex="-1">
        <img src={image.src} alt={imageAlt} loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="project-preview">
        <img src={image.src} alt={imageAlt} loading="lazy" decoding="async" />
      </div>
    )
  )}
</article>
