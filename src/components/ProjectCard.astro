---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";
import { localized } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { data } = project;
const primaryLink = data.links[0]?.url;
---

<article class:list={["project-entry", !data.image && "project-entry--text"]}>
  {data.image && (
    primaryLink ? (
      <a class="project-preview" href={primaryLink} target="_blank" rel="noreferrer">
        <img src={data.image.src} alt={localized(data.image.alt, lang)} loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="project-preview">
        <img src={data.image.src} alt={localized(data.image.alt, lang)} loading="lazy" decoding="async" />
      </div>
    )
  )}
  <div class="project-details">
    <h3>{data.name}</h3>
    <p>{localized(data.summary, lang)}</p>
    {data.technologies.length > 0 && <p class="project-stack">{data.technologies.join(" · ")}</p>}
    {data.links.length > 0 && (
      <p class="project-links">
        {data.links.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer">{localized(link.label, lang)} ↗</a>
        ))}
      </p>
    )}
  </div>
</article>
