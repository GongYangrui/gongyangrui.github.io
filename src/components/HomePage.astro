---
import { getCollection } from "astro:content";
import type { Locale } from "../i18n";
import { localized, ui } from "../i18n";
import { getSiteData, isOngoing } from "../lib/content";
import ResumeEntry from "./ResumeEntry.astro";
import IntroCard from "./IntroCard.astro";
import PublicationEntry from "./PublicationEntry.astro";
import SectionHeading from "./SectionHeading.astro";
import VisitorMap from "./VisitorMap.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];

const [
  { profile, home },
  allExperience,
  allEducation,
  allPublications,
  allHonors,
] = await Promise.all([
  getSiteData(),
  getCollection("experience"),
  getCollection("education"),
  getCollection("publications"),
  getCollection("honors"),
]);

const pickById = <T extends { id: string }>(items: T[], ids: string[]) =>
  ids.map((id) => items.find((item) => item.id === id)).filter((item): item is T => Boolean(item));

const selectedExperience = pickById(allExperience, home.data.experience.itemIds);
const selectedEducation = pickById(allEducation, home.data.education.itemIds);
const selectedPublications = pickById(allPublications, home.data.publications.itemIds);
const selectedHonors = pickById(allHonors, home.data.honors.itemIds);

const current = selectedEducation
  .filter((item) => isOngoing(item.data.period))
  .map((item) => ({
    title: localized(item.data.program, lang),
    place: localized(item.data.institution, lang),
    since: item.data.period.split(/[-–—~]/)[0].trim(),
  }));
---

<div class="home-shell">
  <IntroCard profile={profile.data} {current} {lang} />

  <div class="home-content">
    {home.data.education.enabled && selectedEducation.length > 0 && (
      <section class="home-section" id="education" aria-labelledby="education-heading">
        <SectionHeading id="education-heading" title={t.education} />
        <div class="entry-list">
          {selectedEducation.map((item) => (
            <ResumeEntry
              name={localized(item.data.institution, lang)}
              subtitle={localized(item.data.program, lang)}
              period={item.data.period} url={item.data.url} logo={item.data.logo} {lang}
            />
          ))}
        </div>
      </section>
    )}

    {home.data.experience.enabled && selectedExperience.length > 0 && (
      <section class="home-section" id="experience" aria-labelledby="experience-heading">
        <SectionHeading id="experience-heading" title={t.experience} />
        <div class="entry-list">
          {selectedExperience.map((item) => (
            <ResumeEntry
              name={localized(item.data.organization, lang)}
              description={item.data.description ? localized(item.data.description, lang) : undefined}
              mentorName={item.data.mentor ? localized(item.data.mentor.name, lang) : undefined}
              mentorUrl={item.data.mentor?.url}
              period={item.data.period} url={item.data.url} logo={item.data.logo} {lang}
            />
          ))}
        </div>
      </section>
    )}

    {home.data.publications.enabled && selectedPublications.length > 0 && (
      <section class="home-section" id="publications" aria-labelledby="publications-heading">
        <SectionHeading id="publications-heading" title={t.publications} />
        <div class="publication-list">
          {selectedPublications.map((publication) => (
            <PublicationEntry {publication} {lang} />
          ))}
        </div>
      </section>
    )}

    {home.data.honors.enabled && selectedHonors.length > 0 && (
      <section class="home-section" id="honors" aria-labelledby="honors-heading">
        <SectionHeading id="honors-heading" title={t.honors} />
        <div class="honor-list">
          {selectedHonors.map((honor) => (
            <div class="honor-item">
              <time>{honor.data.date}</time>
              <p class="honor-body">
                {honor.data.award?.[lang] && (
                  <span class="honor-award">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                    </svg>
                    {honor.data.award[lang]}
                  </span>
                )}
                <span class="honor-title">{localized(honor.data.title, lang)}</span>
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    {home.data.visitors?.enabled && home.data.visitors.mapId && (
      <section class="home-section home-section--visitors" id="visitors" aria-labelledby="visitors-heading">
        <SectionHeading id="visitors-heading" title={t.visitors} />
        <VisitorMap mapId={home.data.visitors.mapId} />
      </section>
    )}
  </div>
</div>
