---
import { getCollection } from "astro:content";
import type { Locale } from "../i18n";
import { localePath, localized, ui } from "../i18n";
import { getPublishedWriting, getSiteData } from "../lib/content";
import EntityMark from "./EntityMark.astro";
import IntroCard from "./IntroCard.astro";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";
import WritingList from "./WritingList.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];

const [
  { profile, home },
  allExperience,
  allEducation,
  allProjects,
  allPosts,
  allPublications,
  allHonors,
] = await Promise.all([
  getSiteData(),
  getCollection("experience"),
  getCollection("education"),
  getCollection("projects"),
  getPublishedWriting(lang),
  getCollection("publications"),
  getCollection("honors"),
]);

const pickById = <T extends { id: string }>(items: T[], ids: string[]) =>
  ids.map((id) => items.find((item) => item.id === id)).filter((item): item is T => Boolean(item));

const selectedExperience = pickById(allExperience, home.data.experience.itemIds);
const selectedEducation = pickById(allEducation, home.data.education.itemIds);
const selectedProjects = pickById(allProjects, home.data.projects.itemIds);
const selectedPublications = pickById(allPublications, home.data.publications.itemIds);
const selectedHonors = pickById(allHonors, home.data.honors.itemIds);
const selectedPosts = home.data.writing.itemIds
  .map((key) => allPosts.find((post) => post.data.translationKey === key))
  .filter((post): post is (typeof allPosts)[number] => Boolean(post));
---

<div class="home-shell">
  <IntroCard profile={profile.data} {lang} />

  <div class="home-content prose">
    <section class="home-section" id="about" aria-labelledby="about-heading">
      <SectionHeading id="about-heading" title={t.about} />
      <p>{localized(profile.data.intro, lang)}</p>
    </section>

    {home.data.education.enabled && selectedEducation.length > 0 && (
      <section class="home-section" id="education" aria-labelledby="education-heading">
        <SectionHeading id="education-heading" title={t.education} />
        <div class="entry-list">
          {selectedEducation.map((item) => (
            <div class="entry-item">
              <EntityMark label={localized(item.data.institution, lang)} logo={item.data.logo} />
              <div class="entry-copy">
                <strong>{localized(item.data.institution, lang)}</strong>
                <span>{localized(item.data.program, lang)}</span>
              </div>
              <time>{item.data.period}</time>
            </div>
          ))}
        </div>
      </section>
    )}

    {home.data.experience.enabled && selectedExperience.length > 0 && (
      <section class="home-section" id="experience" aria-labelledby="experience-heading">
        <SectionHeading id="experience-heading" title={t.experience} />
        <div class="entry-list">
          {selectedExperience.map((item) => (
            <div class="entry-item">
              <EntityMark label={localized(item.data.organization, lang)} logo={item.data.logo} />
              <div class="entry-copy">
                <strong>{localized(item.data.organization, lang)}</strong>
                <span>{localized(item.data.role, lang)}</span>
                <p>{localized(item.data.description, lang)}</p>
              </div>
              <time>{item.data.period}</time>
            </div>
          ))}
        </div>
      </section>
    )}

    {home.data.projects.enabled && selectedProjects.length > 0 && (
      <section class="home-section" id="projects" aria-labelledby="projects-heading">
        <SectionHeading
          id="projects-heading"
          title={t.selectedProjects}
          actionLabel={t.projects}
          actionHref={localePath(lang, "/projects/")}
        />
        <div class="project-list">
          {selectedProjects.map((project) => <ProjectCard {project} {lang} />)}
        </div>
      </section>
    )}

    {home.data.writing.enabled && selectedPosts.length > 0 && (
      <section class="home-section" id="writing" aria-labelledby="writing-heading">
        <SectionHeading
          id="writing-heading"
          title={t.writing}
          actionLabel={t.allWriting}
          actionHref={localePath(lang, "/writing/")}
        />
        <WritingList posts={selectedPosts} {lang} />
      </section>
    )}

    {home.data.publications.enabled && selectedPublications.length > 0 && (
      <section class="home-section" id="publications" aria-labelledby="publications-heading">
        <SectionHeading id="publications-heading" title={t.publications} />
        <div class="publication-list">
          {selectedPublications.map((publication) => (
            <article class="publication-entry">
              <h3>{publication.data.title}</h3>
              <p class="publication-authors">{publication.data.authors}</p>
              <p class="publication-venue">{publication.data.venue}</p>
              {publication.data.links.length > 0 && (
                <p class="publication-links">
                  {publication.data.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer">{localized(link.label, lang)} ↗</a>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {home.data.honors.enabled && selectedHonors.length > 0 && (
      <section class="home-section" id="honors" aria-labelledby="honors-heading">
        <SectionHeading id="honors-heading" title={t.honors} />
        <div class="honor-list">
          {selectedHonors.map((honor) => (
            <div class="honor-item">
              <time>{honor.data.date}</time>
              <span>{localized(honor.data.title, lang)}</span>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</div>
