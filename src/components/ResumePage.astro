---
import { getCollection } from "astro:content";
import type { Locale } from "../i18n";
import { localized, ui } from "../i18n";
import { getSiteData } from "../lib/content";
import EntityMark from "./EntityMark.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = ui[lang];
const [{ profile }, experience, education, publications, honors] = await Promise.all([
  getSiteData(),
  getCollection("experience"),
  getCollection("education"),
  getCollection("publications"),
  getCollection("honors"),
]);

const byOrder = <T extends { data: { order: number } }>(items: T[]) =>
  items.sort((a, b) => a.data.order - b.data.order);

byOrder(experience);
byOrder(education);
byOrder(publications);
byOrder(honors);
---

<div class="resume-shell">
  <header class="resume-header">
    <div>
      <p class="eyebrow">{t.resume}</p>
      <h1>{profile.data.name}</h1>
      <p>{localized(profile.data.headline, lang)}</p>
    </div>
    <div class="resume-actions no-print">
      <a class="btn" href="/resume.pdf" download>{t.downloadPdf}</a>
      <a class="link link-hover" href={`mailto:${profile.data.email}`}>{profile.data.email}</a>
    </div>
  </header>

  <section class="resume-section">
    <SectionHeading title={t.experience} />
    <ol class="list entity-list">
      {experience.map((item) => (
        <li class="list-row entity-row">
          <EntityMark name={item.data.organization} logo={item.data.logo} {lang} />
          <div class="list-col-grow entity-copy">
            <h3>{localized(item.data.organization, lang)}</h3>
            <p class="entity-role">{localized(item.data.role, lang)}</p>
            <p>{localized(item.data.description, lang)}</p>
          </div>
          <span class="entity-date">{item.data.period}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="resume-section">
    <SectionHeading title={t.education} />
    <ol class="list entity-list">
      {education.map((item) => (
        <li class="list-row entity-row">
          <EntityMark name={item.data.institution} logo={item.data.logo} {lang} />
          <div class="list-col-grow entity-copy">
            <h3>{localized(item.data.institution, lang)}</h3>
            <p class="entity-role">{localized(item.data.program, lang)}</p>
          </div>
          <span class="entity-date">{item.data.period}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="resume-section publication-section">
    <SectionHeading title={t.publications} />
    <ol class="publication-list">
      {publications.map((publication) => (
        <li>
          <h3>{publication.data.title}</h3>
          <p>{publication.data.authors}</p>
          <p class="publication-venue">{publication.data.venue}</p>
          {publication.data.links.length > 0 && (
            <div class="publication-links">
              {publication.data.links.map((link) => (
                <a class="link link-hover" href={link.url} target="_blank" rel="noreferrer">
                  {localized(link.label, lang)} ↗
                </a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="resume-section">
    <SectionHeading title={t.honors} />
    <ol class="honor-list">
      {honors.map((honor) => (
        <li><span>{honor.data.date}</span><strong>{localized(honor.data.title, lang)}</strong></li>
      ))}
    </ol>
  </section>
</div>
