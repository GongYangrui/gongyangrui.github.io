---
import type { Locale } from "../i18n";
import { localized, ui } from "../i18n";

interface Profile {
  name: string;
  nameZh?: string;
  headline: { en: string; zh: string };
  intro: { en: string; zh: string };
  email: string;
  github: string;
  linkedin?: string;
}

interface Props {
  profile: Profile;
  lang: Locale;
}

const { profile, lang } = Astro.props;
const t = ui[lang];
---

<section class="intro" aria-labelledby="intro-title">
  <div>
    <p class="eyebrow">{t.personalWebsite}</p>
    <h1 id="intro-title">
      {profile.name}
      {profile.nameZh && <span class="chinese-name">{profile.nameZh}</span>}
    </h1>
    <p class="intro-subtitle">{localized(profile.headline, lang)}</p>
    <div class="contact-links" aria-label={t.contact}>
      <a href={profile.github} target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 .9A11.1 11.1 0 0 0 8.49 22.53c.55.1.76-.24.76-.54v-2.12c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.15-2.98-.12-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.43 3.04-1.14 3.04-1.14.61 1.53.23 2.66.11 2.94.72.78 1.15 1.77 1.15 2.98 0 4.26-2.6 5.2-5.08 5.48.4.34.76 1.01.76 2.04v3.01c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
        </svg>
        <span>{t.github}</span>
      </a>
      {profile.linkedin && (
        <a href={profile.linkedin} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.8-1.52 2.99 0 3.57 1.97 3.57 4.53v5.24Z" />
          </svg>
          <span>{t.linkedin}</span>
        </a>
      )}
      <a href={`mailto:${profile.email}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2 7.2-4.7H4.8L12 12.2Zm0 2.3L4 9.6V17h16V9.6l-8 4.9Z" />
        </svg>
        <span>{t.email}</span>
      </a>
    </div>
  </div>
</section>
