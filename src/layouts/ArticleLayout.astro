---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatDate, readingMinutes } from "../lib/content";
import { ui, type Locale } from "../i18n";

interface Props {
  post: CollectionEntry<"writing">;
  headings: { depth: number; slug: string; text: string }[];
  alternatePath: string;
  hasTranslation: boolean;
}

const { post, headings, alternatePath, hasTranslation } = Astro.props;
const lang = post.data.lang as Locale;
const t = ui[lang];
const minutes = readingMinutes(post.body ?? "");
const visibleHeadings = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  {lang}
  title={`${post.data.title} · Yangrui Gong`}
  description={post.data.description}
  canonicalPath={lang === "zh" ? `/zh/writing/${post.data.slug}/` : `/writing/${post.data.slug}/`}
  {alternatePath}
  type="article"
>
  <article class="article-shell">
    <header class="article-header">
      <a class="link link-hover back-link" href={lang === "zh" ? "/zh/writing/" : "/writing/"}>← {t.backToWriting}</a>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        <span>{t.published} {formatDate(post.data.publishedAt, lang)}</span>
        {post.data.updatedAt && <span>{t.updated} {formatDate(post.data.updatedAt, lang)}</span>}
        <span>{minutes} {t.minuteRead}</span>
      </div>
      <div class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
      </div>
      {!hasTranslation && (
        <a class="translation-note link link-hover" href={alternatePath}>{t.noTranslation}</a>
      )}
    </header>

    {visibleHeadings.length > 2 && (
      <nav class="article-toc" aria-label="On this page">
        <ol>
          {visibleHeadings.map((heading) => (
            <li><a class="link link-hover" href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
