---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { localized } from "../../i18n";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const publications = (await getCollection("publications")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  lang="en"
  title="Projects · Yangrui Gong"
  description="Selected projects, tools, and research by Yangrui Gong."
  canonicalPath="/projects/"
  alternatePath="/zh/projects/"
>
  <header class="page-heading">
    <p class="eyebrow">Projects</p>
    <h1>Projects</h1>
    <p>Selected projects, tools, and research.</p>
  </header>

  <div class="projects-content">
    <h2>Projects</h2>
    <div class="project-list">
      {projects.map((project) => <ProjectCard {project} lang="en" />)}
    </div>

    {publications.length > 0 && (
      <>
        <h2>Publications</h2>
        <div class="publication-list">
          {publications.map((publication) => (
            <article class="publication-entry">
              <h3>{publication.data.title}</h3>
              <p class="publication-authors">{publication.data.authors}</p>
              <p class="publication-venue">{publication.data.venue}</p>
              {publication.data.links.length > 0 && (
                <p class="publication-links">
                  {publication.data.links.map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer">{localized(link.label, "en")} ↗</a>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </>
    )}
  </div>
</BaseLayout>
