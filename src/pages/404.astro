---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../i18n";
const t = ui.en;
---

<BaseLayout
  lang="en"
  title="Page not found · Yangrui Gong"
  description="The requested page could not be found."
  canonicalPath="/404.html"
  alternatePath="/zh/"
>
  <div class="not-found">
    <p class="eyebrow">404</p>
    <h1>{t.notFound}</h1>
    <p>{t.notFoundBody}</p>
    <a class="link link-hover primary-link" href="/">{t.goHome} →</a>
  </div>
</BaseLayout>
