---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogDirectory from "../../components/BlogDirectory.astro";
import { getPublishedWriting, groupByPrimaryTag } from "../../lib/content";

const posts = await getPublishedWriting();
const groups = groupByPrimaryTag(posts, "Other");
---

<BaseLayout
  lang="en"
  title="Blogs · Yangrui Gong"
  description="Notes on backend systems, practical AI applications, infrastructure, and tools."
  canonicalPath="/writing/"
  alternatePath="/zh/writing/"
>
  <header class="page-heading">
    <h1>Blogs</h1>
    <p>Notes from my work and study, grouped by topic.</p>
  </header>
  {groups.length > 0 ? (
    <BlogDirectory {groups} lang="en" />
  ) : (
    <p class="empty-state">No posts yet.</p>
  )}
</BaseLayout>
